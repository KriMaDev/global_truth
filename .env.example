# Copy to .env for local runs. Never commit .env.
# In GitHub Actions these are repository secrets, not files.

# Cloudflare (only needed by the scheduled deploy in CI; locally `wrangler login` is enough)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# GitHub token for the Cloudflare timer (worker/index.js). Not a file setting: it is a Worker
# secret, set with `npx wrangler secret put GITHUB_TOKEN -c worker/wrangler.jsonc` (docs/deploy.md). Listed here only
# so it is not forgotten.
# GITHUB_TOKEN=

# ReliefWeb API v2 needs a pre-approved app name (milestone 7)
RELIEFWEB_APPNAME=
