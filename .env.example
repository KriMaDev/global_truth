# Copy to .env for local runs. Never commit .env.
# In GitHub Actions these are repository secrets, not files.

# Cloudflare (only needed by the scheduled deploy in CI; locally `wrangler login` is enough)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ReliefWeb API v2 needs a pre-approved app name (milestone 7)
RELIEFWEB_APPNAME=
