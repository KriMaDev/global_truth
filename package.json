{
  "name": "world-news-globe",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "KriMa (https://krimadev.com)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite frontend",
    "build": "vite build frontend",
    "preview": "vite preview frontend",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p frontend && tsc -p tests",
    "test": "vitest run --root frontend",
    "test:rules": "vitest run --config vitest.baseline.config.ts --project rules",
    "test:browser": "playwright test",
    "test:live": "vitest run --config vitest.baseline.config.ts --project live",
    "test:all": "npm test && npm run test:rules && npm run test:browser && npm run test:live",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test && npm run test:rules",
    "deploy": "npm run verify && wrangler deploy"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/three": "0.186.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.155.0"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/michroma": "5.3.0",
    "globe.gl": "2.46.2",
    "three": "0.186.1"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "@isaacs/nonrecursive-glob-match": "1.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
